@page
@model LoginModel
@{
    ViewData["Title"] = "Σύνδεση";
}

<section class="auth-page-shell">
    <div class="auth-card">
        <div class="auth-header text-center">
            <h1>Σύνδεση Χρήστη</h1>
            <p>Καλώς όρισες.</p>
        </div>

        <form method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="auth-label">Email</label>
                <input asp-for="Input.Email"
                       class="form-control auth-input"
                       placeholder="π.χ. user@email.com"
                       autocomplete="email" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="auth-label">Κωδικός</label>
                <input asp-for="Input.Password"
                       type="password"
                       class="form-control auth-input"
                       placeholder="Πληκτρολόγησε τον κωδικό σου"
                       autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="auth-check-row">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label" asp-for="Input.RememberMe">
                    Να με θυμάσαι
                </label>
            </div>

            <button type="submit" class="auth-submit-btn">
                Σύνδεση
            </button>

            <div class="auth-footer">
                Δεν έχεις λογαριασμό;
                <a asp-page="./Register">Κάνε εγγραφή</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}