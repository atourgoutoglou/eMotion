@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Αλλαγή Κωδικού";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="manage-page-shell py-5">
    <div class="container">
        <div class="manage-page-card">

            <div class="manage-page-header mb-4">
                <h1 class="manage-page-title mt-3">Αλλαγή Κωδικού</h1>

                <p class="manage-page-subtitle mt-2">
                    Ενημέρωσε τον κωδικό πρόσβασης του λογαριασμού σου με ασφάλεια.
                </p>
            </div>

            <div class="row g-4">
                <div class="col-lg-3">
                    <partial name="_ManageNav" />
                </div>

                <div class="col-lg-9">
                    <div class="manage-content-card">

                        <h2 class="manage-section-title mb-4">
                            Ρυθμίσεις Κωδικού
                        </h2>

                        <partial name="_StatusMessage" for="StatusMessage" />

                        <form id="change-password-form" method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3"
                                 role="alert">
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.OldPassword"
                                       class="form-label manage-label">
                                    Τρέχων Κωδικός
                                </label>

                                <input asp-for="Input.OldPassword"
                                       class="form-control manage-input"
                                       autocomplete="current-password" />

                                <span asp-validation-for="Input.OldPassword"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.NewPassword"
                                       class="form-label manage-label">
                                    Νέος Κωδικός
                                </label>

                                <input asp-for="Input.NewPassword"
                                       class="form-control manage-input"
                                       autocomplete="new-password" />

                                <span asp-validation-for="Input.NewPassword"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Input.ConfirmPassword"
                                       class="form-label manage-label">
                                    Επιβεβαίωση Κωδικού
                                </label>

                                <input asp-for="Input.ConfirmPassword"
                                       class="form-control manage-input"
                                       autocomplete="new-password" />

                                <span asp-validation-for="Input.ConfirmPassword"
                                      class="text-danger small">
                                </span>
                            </div>

                            <button type="submit"
                                    class="btn btn-main px-4">
                                Αποθήκευση Νέου Κωδικού
                            </button>

                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}