@page
@model RegisterModel
@{
    ViewData["Title"] = "Εγγραφή";
}

<section class="auth-page-shell">
    <div class="auth-card">
        <div class="auth-header text-center">
            <h1>Εγγραφή Χρήστη</h1>
            <p>Δημιούργησε τον λογαριασμό σου.</p>
        </div>

        <form method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.Username" class="auth-label">Όνομα Χρήστη</label>
                <input asp-for="Input.Username" class="form-control auth-input" autocomplete="username" />
                <span asp-validation-for="Input.Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="auth-label">Email</label>
                <input asp-for="Input.Email" class="form-control auth-input" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.Password" class="auth-label">Κωδικός</label>
                    <input asp-for="Input.Password" type="password" class="form-control auth-input" autocomplete="new-password" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.ConfirmPassword" class="auth-label">Επιβεβαίωση</label>
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control auth-input" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-3">
                <label asp-for="Input.Role" class="auth-label">Ρόλος Χρήστη</label>
                <select asp-for="Input.Role" class="form-select auth-input">
                    <option value="Student">Μαθητής</option>
                    <option value="Teacher">Καθηγητής</option>
                </select>
                <span asp-validation-for="Input.Role" class="text-danger small"></span>
            </div>

            <div class="mt-3">
                <label asp-for="Input.TeacherSecretCode" class="auth-label auth-label-warning">
                    Κωδικός Καθηγητή
                </label>
                <input asp-for="Input.TeacherSecretCode" class="form-control auth-input" placeholder="Συμπλήρωσε μόνο αν είσαι καθηγητής" />
                <span asp-validation-for="Input.TeacherSecretCode" class="text-danger small"></span>
            </div>

            <button type="submit" class="auth-submit-btn">
                Δημιουργία Λογαριασμού
            </button>

            <div class="auth-footer">
                Έχεις ήδη λογαριασμό;
                <a asp-page="./Login">Σύνδεση</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}