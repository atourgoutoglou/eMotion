@{
    ViewData["Title"] = "Αποστολή Μηνύματος";
}

<section class="teacher-dashboard-page py-5">
    <div class="container">

        <div class="teacher-glass-panel">

            <h2 class="text-white mb-4">
                Αποστολή Μηνύματος Μαθητή
            </h2>

            <form asp-controller="Teacher"
                  asp-action="SendMessage"
                  method="post">

                <input type="hidden"
                       name="studentId"
                       value="@ViewBag.StudentId" />

                <div class="mb-3">
                    <label class="form-label text-white">
                        Μήνυμα
                    </label>

                    <textarea name="message"
                              class="form-control teacher-reply-textarea"
                              rows="6"
                              required
                              placeholder="Γράψε την παιδαγωγική παρέμβαση..."></textarea>
                </div>

                <div class="d-flex flex-wrap gap-3 mt-4">
                    <button type="submit"
                            class="btn teacher-send-reply-btn">
                        Αποστολή
                    </button>

                    <a asp-controller="Teacher"
                       asp-action="Index"
                       class="btn teacher-send-reply-btn">
                        Ακύρωση
                    </a>
                </div>

            </form>

        </div>

    </div>
</section>