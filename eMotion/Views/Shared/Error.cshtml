@model ErrorViewModel

@{
    ViewData["Title"] = "Σφάλμα";
}

<section class="student-page-shell py-5">
    <div class="container">

        <div class="glass-panel text-center p-5">

            <div class="mb-4" style="font-size: 4rem;">
            </div>

            <h1 class="text-white fw-bold mb-3">
                Παρουσιάστηκε σφάλμα
            </h1>

            <p class="text-light opacity-75 mb-4">
                Κάτι πήγε στραβά κατά την επεξεργασία του αιτήματός σου.
                Παρακαλώ δοκίμασε ξανά αργότερα.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="glass-card-soft p-3 mb-4 d-inline-block">
                    <strong>Αναγνωριστικό Αιτήματος:</strong>
                    <code>@Model.RequestId</code>
                </div>
            }

            <div class="d-flex justify-content-center gap-3 flex-wrap">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-main">
                    Επιστροφή στην Αρχική
                </a>

                <a href="javascript:history.back()"
                   class="btn btn-outline-glass">
                    Προηγούμενη Σελίδα
                </a>

            </div>

        </div>

    </div>
</section>