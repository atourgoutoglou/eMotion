                <a href="#emotion-engine">Μηχανισμός Ανάλυσης</a>
            </div>

            <div class="footer-column">
                <h3>Μαθήματα</h3>

                <a asp-controller="Student" asp-action="Chapter1">Κεφάλαιο 1</a>
                <a asp-controller="Student" asp-action="Chapter2">Κεφάλαιο 2</a>
                <a asp-controller="Student" asp-action="Chapter3">Κεφάλαιο 3</a>
                <a asp-controller="Student" asp-action="Chapter4">Κεφάλαιο 4</a>
            </div>

            <div class="footer-column">
