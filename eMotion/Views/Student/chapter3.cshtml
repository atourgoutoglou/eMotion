                   target="_blank"
                   class="btn btn-main chapter-action-btn"
                   onclick="saveStepActivity('Theory')">

                    Άνοιγμα Παρουσίασης

                </a>

                <a id="downloadPresentationBtn"
                   href="~/files/chapter3/chapter3.pptx"
                   class="btn btn-outline-light chapter-secondary-btn"
                   download
