@{
    ViewData["Title"] = "Κεφάλαιο 3 - Βασικές Έννοιες ΓΛΩΣΣΑΣ";
}

<section class="chapter-page py-5">
    <div class="container">

        <div class="chapter-hero-card mb-5">
            <div class="row align-items-center g-4">

                <div class="col-lg-8">

                    <span class="pill-badge">
                        Κεφάλαιο 3 • ΑΕΠΠ Γ' Λυκείου
                    </span>

                    <h1 class="chapter-hero-title mt-3">
                        Βασικές Έννοιες ΓΛΩΣΣΑΣ
                    </h1>

                    <p class="chapter-hero-text mt-3">
                        Στο τρίτο κεφάλαιο ο μαθητής γνωρίζει βασικές έννοιες της ΓΛΩΣΣΑΣ,
                        όπως το αλφάβητο, οι τύποι δεδομένων, οι μεταβλητές, οι σταθερές,
                        οι αριθμητικές εκφράσεις, η εντολή εκχώρησης και οι βασικές εντολές
                        εισόδου και εξόδου.
                    </p>

                </div>

                <div class="col-lg-4 text-center">

                    <div class="chapter-hero-image-wrap">
                        <img src="~/images/programming-course.png"
                             class="chapter-hero-image"
                             alt="Βασικές Έννοιες ΓΛΩΣΣΑΣ" />
                    </div>

                </div>

            </div>
        </div>

        <div class="glass-panel emotion-hud mb-4" id="emotionHud">

            <div class="emotion-hud-top">

                <div>

                    <span class="emotion-chip neutral" id="emotionChip">
                        Ουδέτερο
                    </span>

                    <h4 class="emotion-hud-title mt-3 mb-1">
                        Μηχανισμός Ανίχνευσης Συναισθήματος
                    </h4>

                    <p class="emotion-hud-subtitle mb-0">
                        Ζωντανή εκτίμηση συναισθηματικής κατάστασης.
                    </p>

                </div>

                <div class="emotion-confidence-box">

                    <div class="emotion-confidence-label">
                        Βεβαιότητα
                    </div>

                    <div class="emotion-confidence-value"
                         id="emotionConfidence">
                        0%
                    </div>

                </div>

            </div>

            <div class="row g-3 mt-2">

                <div class="col-md-4">

                    <div class="glass-card h-100">

                        <span class="mini-status-label">
                            Τρέχον Συναίσθημα
                        </span>

                        <strong id="liveEmotionText">
                            Ουδέτερο
                        </strong>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="glass-card h-100">

                        <span class="mini-status-label">
                            Προσαρμοστική Δυσκολία
                        </span>

                        <strong id="liveDifficultyText">
                            Μεσαία
                        </strong>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="glass-card h-100">

                        <span class="mini-status-label">
                            Ενέργεια Υποστήριξης
                        </span>

                        <strong id="liveSupportText">
                            Συνέχεια
                        </strong>

                    </div>

                </div>

            </div>

            <div class="adaptive-explanation mt-3"
                 id="adaptiveExplanation">

                Το σύστημα παρακολουθεί χρόνο, απαντήσεις, αλλαγές επιλογών και αδράνεια.

            </div>

        </div>

        <div class="row g-4 mb-5">

            <div class="col-lg-4">

                <div class="glass-card-soft h-100">

                    <h3 class="chapter-card-title">
                        Τι θα μάθεις
                    </h3>

                    <ul class="chapter-list">
                        <li>Από τι αποτελείται το αλφάβητο της ΓΛΩΣΣΑΣ</li>
                        <li>Ποιοι είναι οι βασικοί τύποι δεδομένων</li>
                        <li>Πώς δηλώνονται και χρησιμοποιούνται οι μεταβλητές και οι σταθερές</li>
                        <li>Πώς λειτουργούν οι εντολές εκχώρησης, ΔΙΑΒΑΣΕ και ΓΡΑΨΕ</li>
                    </ul>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="glass-card-soft h-100">

                    <h3 class="chapter-card-title">
                        Γιατί είναι σημαντικό
                    </h3>

                    <p class="chapter-card-text">
                        Η σωστή χρήση τύπων δεδομένων, μεταβλητών και εντολών αποτελεί
                        βασική προϋπόθεση για τη δημιουργία σωστών προγραμμάτων στη ΓΛΩΣΣΑ.
                    </p>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="glass-card-soft h-100">

                    <h3 class="chapter-card-title">
                        Μαθησιακός στόχος
                    </h3>

                    <p class="chapter-card-text">
                        Με την ολοκλήρωση της ενότητας, θα μπορείτε να αναγνωρίζετε
                        τύπους δεδομένων, να χρησιμοποιείτε ορθά ονόματα μεταβλητών και να
                        κατανοείτε βασικές εντολές προγραμμάτων.
                    </p>

                </div>

            </div>

        </div>

        <div id="theoryPanel" class="glass-panel mb-5">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">

                <div>

                    <span class="pill-badge">
                        Παρουσίαση Μαθήματος
                    </span>

                    <h2 class="chapter-section-title mt-2 mb-1"
                        id="theoryPanelTitle">

                        PowerPoint Ενότητας

                    </h2>

                </div>

            </div>

            <div class="chapter-embed-box"
