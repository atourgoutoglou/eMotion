        document.addEventListener("DOMContentLoaded", function () {
            renderQuizSet("base");
            setupEmotionButtons();
            setupQuizTracking();
            setupMaterialTracking();
            setupIdleTracking();
            startLiveEmotionPolling();

            quizStart = Date.now();
            analyzeEmotionLive();
        });

        function translateEmotion(emotion) {
            return emotionLabels[emotion] || emotion || "Ουδέτερο";
        }

        function translateDifficulty(level) {
            return difficultyLabels[level] || level || "Μεσαία";
        }

        function translateSupportAction(action) {
            return supportActionLabels[action] || action || "Συνέχεια";
        }

        function setupEmotionButtons() {
            const buttons = document.querySelectorAll(".emotion-btn");

            buttons.forEach(btn => {
                btn.addEventListener("click", function () {
                    buttons.forEach(b => b.classList.remove("active"));
                    this.classList.add("active");

                    selectedSelfEmotion = this.dataset.selfEmotion || null;

                    const resultBox = document.getElementById("selfReportResult");
                    if (resultBox) {
                        resultBox.innerText = `Καταγράφηκε αυτοαναφορά: ${translateEmotion(selectedSelfEmotion)}`;
                    }

                    registerUserActivity();
                    analyzeEmotionLive();
                });
            });
        }

        function renderQuizSet(mode) {

            currentQuizMode = mode;
            const config = quizSets[mode] || quizSets.base;

            const tfTitle = document.getElementById("trueFalseTitle");
            const tfSubtitle = document.getElementById("trueFalseSubtitle");
            const mcTitle = document.getElementById("multipleChoiceTitle");
            const mcSubtitle = document.getElementById("multipleChoiceSubtitle");
            const tfForm = document.getElementById("trueFalseForm");
            const mcForm = document.getElementById("multipleChoiceForm");

            if (tfTitle) tfTitle.innerText = config.trueFalseTitle;
            if (tfSubtitle) tfSubtitle.innerText = config.trueFalseSubtitle;
            if (mcTitle) mcTitle.innerText = config.multipleChoiceTitle;
            if (mcSubtitle) mcSubtitle.innerText = config.multipleChoiceSubtitle;

            if (tfForm) {
                tfForm.innerHTML = buildQuizHtml(config.trueFalseQuestions);
            }

            if (mcForm) {
                mcForm.innerHTML = buildQuizHtml(config.multipleChoiceQuestions);
            }

            questionNames = [
                ...config.trueFalseQuestions.map(q => q.name),
                ...config.multipleChoiceQuestions.map(q => q.name)
            ];

            const resultsPanel = document.getElementById("quizResultsPanel");
            const resultsSummary = document.getElementById("quizResultsSummary");
            const resultsList = document.getElementById("quizResultsList");

            if (resultsPanel) {
                resultsPanel.classList.add("d-none");
            }

            if (resultsSummary) {
                resultsSummary.innerHTML = "";
            }

            if (resultsList) {
                resultsList.innerHTML = "";
            }

            previousAnswers = {};
            setupQuizTracking();
        }

        function buildQuizHtml(questions) {
            return questions
                .map(question => `
                    <div class="quiz-question-block">

                        <h5 class="quiz-question">
                            ${question.text}
                        </h5>

                        ${question.options
                        .map(option => `
                                <div class="form-check quiz-option">

                                    <input
                                        class="form-check-input"
                                        type="radio"
                                        name="${question.name}"
                                        id="${option.id}"
                                        value="${option.value}">

                                    <label
                                        class="form-check-label"
                                        for="${option.id}">
                                        ${option.text}
                                    </label>

                                </div>
                            `)
                        .join("")}

                    </div>
                `)
                .join("");
        }

        function setupQuizTracking() {
            const inputs = document.querySelectorAll("input[type='radio'], input[type='checkbox'], select");

            inputs.forEach(input => {
                input.removeEventListener("change", handleQuizChange);
                input.addEventListener("change", handleQuizChange);
            });

            const textInputs = document.querySelectorAll("textarea, input[type='text']");
            textInputs.forEach(input => {
                input.removeEventListener("input", handleTextInput);
                input.addEventListener("input", handleTextInput);
            });
        }

        function handleQuizChange() {
            const key = this.name || this.id || Math.random().toString();
            const currentValue = this.value;

            if (previousAnswers[key] !== undefined && previousAnswers[key] !== currentValue) {
                changes++;
            }

            previousAnswers[key] = currentValue;

            if (!quizStart) {
                quizStart = Date.now();
            }

            registerUserActivity();
            analyzeEmotionLive();
        }

        function handleTextInput() {
            registerUserActivity();
        }

        function setupMaterialTracking() {
            const materialElements = document.querySelectorAll(
                "a, iframe, .resource-card, .chapter-iframe, .chapter-action-btn, .chapter-secondary-btn"
            );

            materialElements.forEach(item => {
                item.removeEventListener("click", handleMaterialClick);
                item.addEventListener("click", handleMaterialClick);
            });
        }

        function handleMaterialClick() {
            materialClicks++;
            registerUserActivity();
        }

        function setupIdleTracking() {
            const activityEvents = ["mousemove", "keydown", "click", "scroll", "touchstart"];

            activityEvents.forEach(eventName => {
                document.addEventListener(eventName, registerUserActivity, true);
            });

            idleInterval = setInterval(() => {
                const now = Date.now();
                const inactiveFor = Math.floor((now - lastActivityTimestamp) / 1000);

                idleSeconds = inactiveFor < 0 ? 0 : inactiveFor;

                if (inactiveFor >= 90 && !adaptiveMode) {
                    const idleResult = {
                        emotion: "Idle",
                        title: "Παρατηρήθηκε αδράνεια",
                        message: "Φαίνεται ότι υπήρξε διακοπή στην αλληλεπίδραση. Μετά την ολοκλήρωση της ενότητας μπορεί να ενεργοποιηθεί προσαρμοσμένη συνέχεια.",
                        confidence: 0.95,
                        difficultyLevel: "Easy",
                        supportAction: "ShowSummary",
                        uiMode: "idle",
                        reasons: ["Μεγάλος χρόνος αδράνειας"],
                        recommendations: [
                            "Σύντομη επανάληψη βασικών σημείων",
                            "Επανεκκίνηση με πιο απλό βήμα"
                        ]
                    };

                    updateEmotionHud(idleResult);
                    applyAdaptiveUi(idleResult);
                }
            }, 1000);
        }

        function registerUserActivity() {
            lastActivityTimestamp = Date.now();
            idleSeconds = 0;
        }

        function calculateCorrectAnswers() {
            let correct = 0;

            document.querySelectorAll('input[type="radio"]:checked').forEach(input => {
                if (input.value === "correct") {
                    correct++;
                }
            });

            return correct;
        }

        function calculateWrongAnswers() {
            let wrong = 0;

            document.querySelectorAll('input[type="radio"]:checked').forEach(input => {
                if (input.value === "wrong") {
                    wrong++;
                }
            });

            return wrong;
        }

        function getAnsweredQuestionsCount() {
            let answered = 0;

            questionNames.forEach(name => {
                const checked = document.querySelector(`input[name="${name}"]:checked`);
                if (checked) {
                    answered++;
                }
            });

            return answered;
        }

        function getTotalQuestions() {
            return questionNames.length;
        }

        function buildLiveActivitySnapshot(activityType = "") {
            const correctAnswers = calculateCorrectAnswers();
            const wrongAnswers = calculateWrongAnswers();
            const answeredQuestions = getAnsweredQuestionsCount();

            const totalPageTime = Math.floor((Date.now() - pageStart) / 1000);
            const quizTime = quizStart
                ? Math.floor((Date.now() - quizStart) / 1000)
                : 0;

            const theoryTime = Math.max(totalPageTime - quizTime, 0);

            return {
                ChapterName: chapterName,
                ActivityType: activityType,
                Score: correctAnswers,
                CorrectAnswers: correctAnswers,
                WrongAnswers: wrongAnswers,
                Attempts: attempts,
                TheoryTimeSeconds: theoryTime,
                QuizTimeSeconds: quizTime,
                AnswerChanges: changes,
                MaterialClicks: materialClicks,
                IdleTimeSeconds: idleSeconds,
                SelfReportedEmotion: selectedSelfEmotion || "",
                AnsweredQuestions: answeredQuestions,
                TotalQuestions: getTotalQuestions()
            };
        }

        function saveStepActivity(activityType) {
            const data = buildLiveActivitySnapshot(activityType);

            fetch('/Student/SaveActivity', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error("Αποτυχία αποθήκευσης βήματος");
                    }

                    console.log("Αποθηκεύτηκε βήμα:", activityType);
                })
                .catch(error => {
                    console.error("Σφάλμα αποθήκευσης βήματος:", error);
                });
        }

        function analyzeEmotionLive() {
            const data = buildLiveActivitySnapshot("");

            fetch('/Student/AnalyzeLive', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error("Αποτυχία ζωντανής ανάλυσης");
                    }
                    return response.json();
                })
                .then(result => {
                    updateEmotionHud(result);
                    applyAdaptiveUi(result);
                })
                .catch(error => {
                    console.error("Σφάλμα ζωντανής ανάλυσης:", error);
                });
        }

        function startLiveEmotionPolling() {
            liveEmotionInterval = setInterval(() => {
                if (!adaptiveMode) {
                    analyzeEmotionLive();
                }
            }, 15000);
        }

        function updateEmotionHud(result) {
            const emotionText = document.getElementById("liveEmotionText");
            const difficultyText = document.getElementById("liveDifficultyText");
            const supportText = document.getElementById("liveSupportText");
            const confidenceText = document.getElementById("emotionConfidence");
            const chip = document.getElementById("emotionChip");
            const explanation = document.getElementById("adaptiveExplanation");

            if (emotionText) emotionText.innerText = translateEmotion(result.emotion);
            if (difficultyText) difficultyText.innerText = translateDifficulty(result.difficultyLevel);
            if (supportText) supportText.innerText = translateSupportAction(result.supportAction);
            if (confidenceText) confidenceText.innerText = `${Math.round((result.confidence || 0) * 100)}%`;

            if (chip) {
                chip.innerText = translateEmotion(result.emotion);
                chip.className = "emotion-chip " + (result.uiMode || "neutral");
            }

            if (explanation) {
                const reasons = (result.reasons || []).join(" • ");
                explanation.innerText = reasons || result.message || "Δεν υπάρχουν ακόμη επαρκή δεδομένα.";
            }
        }

        function applyAdaptiveUi(result) {
            const body = document.body;

            body.classList.remove(
                "ui-mode-neutral",
                "ui-mode-support",
                "ui-mode-focus",
                "ui-mode-calm",
                "ui-mode-boost",
                "ui-mode-idle"
            );

            body.classList.add(`ui-mode-${result.uiMode || "neutral"}`);

            const quizPanels = document.querySelectorAll(".quiz-card");

            quizPanels.forEach(panel => {
                panel.classList.remove("quiz-easy", "quiz-medium", "quiz-hard");
                panel.classList.add(`quiz-${(result.difficultyLevel || "Medium").toLowerCase()}`);
            });
        }

        function openEmotionPanel() {
            const panel = document.getElementById("emotionSidePanel");
            const overlay = document.getElementById("emotionOverlay");

            if (panel) panel.classList.add("open");
            if (overlay) overlay.classList.add("show");
        }

        function closeEmotionPanel() {
            const panel = document.getElementById("emotionSidePanel");
            const overlay = document.getElementById("emotionOverlay");

            if (panel) panel.classList.remove("open");
            if (overlay) overlay.classList.remove("show");
        }

        function getBadgeText(emotion) {
            switch (emotion) {
                case "Confident":
                    return "Θετική πορεία";
                case "Frustrated":
                    return "Χρειάζεται ενίσχυση";
                case "Anxious":
                    return "Υποστηρικτικό feedback";
                case "Tired":
                    return "Ρυθμός μάθησης";
                case "Idle":
                    return "Επανενεργοποίηση";
                default:
                    return "Σταθερή πορεία";
            }
        }

        function getCurrentQuizQuestions() {

            const currentSet =
                quizSets[currentQuizMode] || quizSets.base;

            return [
                ...currentSet.trueFalseQuestions,
                ...currentSet.multipleChoiceQuestions
            ];
        }

        function toggleQuizResults() {

            const panel = document.getElementById("quizResultsPanel");
            const button = document.getElementById("toggleQuizResultsBtn");

            if (!panel || !button) return;

            if (!panel.classList.contains("d-none")) {

                panel.classList.add("d-none");

                button.innerText = "Προβολή αποτελεσμάτων quiz";

                return;
            }

            showQuizResults();

            panel.classList.remove("d-none");

            button.innerText = "Απόκρυψη αποτελεσμάτων quiz";

            panel.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });
        }

        function showQuizResults() {

            const summary = document.getElementById("quizResultsSummary");
            const resultsList = document.getElementById("quizResultsList");

            if (!summary || !resultsList) return;

            const questions = getCurrentQuizQuestions();

            let correctCount = 0;
            let wrongCount = 0;
            let unansweredCount = 0;

            let html = "";

            questions.forEach(question => {

                const selected =
                    document.querySelector(`input[name="${question.name}"]:checked`);

                const correctOption =
                    question.options.find(option => option.value === "correct");

                let selectedText = "Δεν απαντήθηκε";

                let isCorrect = false;

                if (selected) {

                    const selectedOption =
                        question.options.find(option => option.id === selected.id);

                    selectedText = selectedOption?.text || selected.value;

                    isCorrect = selected.value === "correct";
                }

                if (isCorrect) {
                    correctCount++;
                }
                else if (!selected) {
                    unansweredCount++;
                }
                else {
                    wrongCount++;
                }

                html += `
            <div class="quiz-feedback-card ${isCorrect ? "correct" : "wrong"}">

                <div class="quiz-feedback-question">
                    ${question.text}
                </div>

                <div class="quiz-feedback-answer">
                    <strong>Η απάντησή σου:</strong>
                    <span>${selectedText}</span>
                </div>

                <div class="quiz-feedback-answer">
                    <strong>Σωστή απάντηση:</strong>
                    <span>${correctOption?.text || "-"}</span>
                </div>

                <div class="quiz-feedback-status ${isCorrect ? "correct" : "wrong"}">
                    ${isCorrect
                        ? "Σωστή απάντηση"
                        : "Λανθασμένη απάντηση"}
                </div>

            </div>
        `;
            });

            const total = questions.length;

            const percentage =
                total > 0
                    ? Math.round((correctCount / total) * 100)
                    : 0;

            summary.innerHTML = `
                        <div class="quiz-result-stat">
                            <span>Σωστές απαντήσεις</span>
                            <strong>${correctCount}/${total}</strong>
                        </div>

                        <div class="quiz-result-stat">
                            <span>Λανθασμένες απαντήσεις</span>
                            <strong>${wrongCount}</strong>
                        </div>

                        <div class="quiz-result-stat">
                            <span>Αναπάντητες</span>
                            <strong>${unansweredCount}</strong>
                        </div>

                        <div class="quiz-result-stat">
                            <span>Ποσοστό επιτυχίας</span>
                            <strong>${percentage}%</strong>
                        </div>
                    `;

            resultsList.innerHTML = html;
        }

        function submitFinalAnalysis() {
            attempts++;

            const data = buildLiveActivitySnapshot("Quiz");

            fetch('/Student/SaveActivity', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
                .then(async response => {
                    if (!response.ok) {
                        throw new Error("Αποτυχία αποθήκευσης");
                    }

                    const result = await response.json();

                    lastAnalysisResult = result;

                    updateEmotionHud(result);
                    applyAdaptiveUi(result);
                    showFeedback(result);
                })
                .catch(error => {
                    console.error(error);
                    alert("Παρουσιάστηκε σφάλμα κατά την αποθήκευση.");
                });
        }

        function showFeedback(result) {
            const badge = document.getElementById("emotionPanelBadge");
            const title = document.getElementById("emotionPanelTitle");
            const message = document.getElementById("emotionPanelMessage");
            const body = document.getElementById("emotionPanelBody");

            if (!badge || !title || !message || !body) {
                console.warn("Δεν βρέθηκαν τα στοιχεία του πλευρικού πίνακα συναισθήματος.");
                return;
            }

            badge.innerText = getBadgeText(result.emotion || "Neutral");
            title.innerText = result.title || "Υποστηρικτικό feedback";
            message.innerText = result.message || "";

            const reasonsHtml = (result.reasons || [])
                .map(reason => `<li>${reason}</li>`)
                .join("");

            const recommendationsHtml = (result.recommendations || [])
                .map(recommendation => `<li>${recommendation}</li>`)
                .join("");

            body.innerHTML = `
            <div class="theory-mini-file">

                <p>
                    <strong>Συναίσθημα:</strong>
                    ${translateEmotion(result.emotion) || "-"}
                </p>

                <p>
                    <strong>Βεβαιότητα:</strong>
                    ${Math.round((result.confidence || 0) * 100)}%
                </p>

                <p>
                    <strong>Προσαρμοστική ενέργεια:</strong>
                    ${translateSupportAction(result.supportAction) || "-"}
                </p>

                <p>
                    <strong>Προτεινόμενη δυσκολία:</strong>
                    ${translateDifficulty(result.difficultyLevel) || "-"}
                </p>

                <div class="mt-3">
                    <h6>Λόγοι απόφασης</h6>

                    <ul>
                        ${reasonsHtml}
                    </ul>
                </div>

                <div class="adaptive-recommendations-box mt-3">
                    <h6>Προτεινόμενες παρεμβάσεις</h6>

                    <ul>
                        ${recommendationsHtml}
                    </ul>
                </div>

                <div class="mt-4 d-flex flex-wrap gap-2">

                    <button
                        type="button"
                        class="btn btn-main chapter-action-btn"
                        onclick="continueAdaptiveLesson()">
                        Συνέχεια
                    </button>

                    <button
                        type="button"
                        class="btn btn-outline-light chapter-secondary-btn"
                        onclick="closeEmotionPanel()">
                        Κλείσιμο
                    </button>

                </div>

            </div>
        `;

            openEmotionPanel();
        }

        function continueAdaptiveLesson() {
            if (!lastAnalysisResult) return;

            adaptiveMode = true;
            applyAdaptiveLesson(lastAnalysisResult);
            closeEmotionPanel();

            const theoryPanel = document.getElementById("theoryPanel");
            if (theoryPanel) {
                theoryPanel.scrollIntoView({ behavior: "smooth", block: "start" });
            }
        }

        function applyAdaptiveLesson(result) {
            const emotion = result.emotion || "Neutral";
            const action = result.supportAction || "Continue";

            updateTheoryByEmotion(emotion, action);
            updateQuizzesByEmotion(emotion, action);
        }

        function updateTheoryByEmotion(emotion, action) {
            const config = theoryConfigs[emotion] || theoryConfigs.default;

            const title = document.getElementById("theoryPanelTitle");
            const iframe = document.getElementById("theoryIframe");
            const openBtn = document.getElementById("openPresentationBtn");
            const downloadBtn = document.getElementById("downloadPresentationBtn");
            const supportBox = document.getElementById("theorySupportBox");

            if (title) title.innerText = config.title;
            if (iframe) iframe.src = config.pdf;
            if (openBtn) openBtn.href = config.pdf;
            if (downloadBtn) downloadBtn.href = config.pptx;

            if (!supportBox) return;

            supportBox.classList.remove("d-none");
            supportBox.innerHTML = "";

            if (emotion === "Frustrated" || action === "ShowScaffoldedTheory") {
                supportBox.innerHTML = `
                <div class="adaptive-inline-card">

                    <h4>Υποστηρικτική θεωρία</h4>

                    <p>
                        Ενεργοποιήθηκε η υποστηρικτική εκδοχή της θεωρίας
                        με πιο απλή παρουσίαση.
                    </p>

                </div>
            `;

                return;
            }

            if (emotion === "Anxious" || action === "ShowHints") {
                supportBox.innerHTML = `
                <div class="adaptive-inline-card">

                    <h4>Καθοδηγητική θεωρία</h4>

                    <p>
                        Ενεργοποιήθηκε καθοδηγητική θεωρία με περισσότερη
                        βήμα-βήμα υποστήριξη.
                    </p>

                </div>
            `;

                return;
            }

            if (emotion === "Tired" || action === "ShowBreakSuggestion") {
                supportBox.innerHTML = `
                <div class="adaptive-inline-card">

                    <h4>Σύντομη επανάληψη</h4>

                    <p>
                        Προβάλλεται πιο ήπια και σύντομη εκδοχή της θεωρίας
                        για σταδιακή συνέχεια.
                    </p>

                </div>
            `;

                return;
            }

            if (emotion === "Idle" || action === "ShowSummary") {
                supportBox.innerHTML = `
                <div class="adaptive-inline-card">

                    <h4>Επανεκκίνηση ενότητας</h4>

                    <p>
                        Παρέχεται καθοδηγητική επανεκκίνηση πριν συνεχίσεις
                        την εξάσκηση.
                    </p>

                </div>
            `;

                return;
            }

            if (emotion === "Confident" || action === "UnlockChallenge") {
                supportBox.classList.add("d-none");
                supportBox.innerHTML = "";
                return;
            }

            supportBox.classList.add("d-none");
        }

        function updateQuizzesByEmotion(emotion, action) {
            if (emotion === "Confident" || action === "UnlockChallenge") {
                renderQuizSet("challenge");
                return;
            }

            if (emotion === "Frustrated" || action === "ShowScaffoldedTheory") {
                renderQuizSet("support");
                return;
            }

            if (emotion === "Anxious" || action === "ShowHints") {
                renderQuizSet("guided");
                return;
            }

            if (emotion === "Tired" || action === "ShowBreakSuggestion" || emotion === "Idle" || action === "ShowSummary") {
                renderQuizSet("summary");
                return;
            }

            renderQuizSet("base");
        }

        window.addEventListener("beforeunload", function () {
            if (idleInterval) clearInterval(idleInterval);
            if (liveEmotionInterval) clearInterval(liveEmotionInterval);
        });
    </script>
}